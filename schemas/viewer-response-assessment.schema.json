{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/masa-san-jp/agentic-art-orchestration/schemas/viewer-response-assessment.schema.json",
  "title": "Viewer response assessment adapter",
  "description": "Parent-owned boundary copy of the viewer assessment envelope; viewer-response-notes remains the record and domain SSOT.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "assessment_id", "work_id", "requirement_id", "presentation_mode", "matching_tags", "status", "measured_sample_size", "outcome_counts", "confidence_interval", "source_record_ids", "external_evidence_refs", "conflict", "review_required", "review_kind", "source_commits"],
  "properties": {
    "schema_id": {"const": "viewer-response-assessment/v1"},
    "assessment_id": {"type": "string", "pattern": "^VRA-[A-Z0-9][A-Z0-9._-]*$"},
    "work_id": {"type": "string", "minLength": 1},
    "requirement_id": {"type": "string", "minLength": 1},
    "presentation_mode": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "matching_tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "status": {"enum": ["UNKNOWN", "SUPPORTED", "CONTRADICTED", "EXTERNALLY_SUPPORTED"]},
    "measured_sample_size": {"type": "integer", "minimum": 0},
    "outcome_counts": {
      "type": "object", "additionalProperties": false, "required": ["pass", "fail", "unknown"],
      "properties": {"pass": {"type": "integer", "minimum": 0}, "fail": {"type": "integer", "minimum": 0}, "unknown": {"type": "integer", "minimum": 0}}
    },
    "confidence_interval": {
      "type": ["object", "null"], "additionalProperties": false, "required": ["level", "lower", "upper"],
      "properties": {"level": {"const": 0.95}, "lower": {"type": "number", "minimum": 0, "maximum": 1}, "upper": {"type": "number", "minimum": 0, "maximum": 1}}
    },
    "source_record_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "external_evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "conflict": {"type": "boolean"},
    "review_required": {"type": "boolean"},
    "review_kind": {"enum": ["NONE", "BLIND_OR_FRAME"]},
    "source_commits": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}
  }
}
