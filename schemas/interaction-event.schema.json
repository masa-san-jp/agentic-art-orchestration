{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/masa-san-jp/agentic-art-orchestration/schemas/interaction-event.schema.json",
  "title": "Interaction event v1",
  "description": "A privacy-minimal experience outcome envelope without raw conversation text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "interaction_id",
    "event_id",
    "event_type",
    "occurred_at",
    "session_ref",
    "agent",
    "intent",
    "source_snapshots",
    "signal_refs",
    "outcome",
    "explicit_feedback_refs",
    "privacy"
  ],
  "properties": {
    "contract_version": {
      "const": "interaction-event/v1"
    },
    "interaction_id": {
      "$ref": "#/$defs/stable_id"
    },
    "event_id": {
      "$ref": "#/$defs/stable_id"
    },
    "event_type": {
      "const": "experience-outcome"
    },
    "occurred_at": {
      "$ref": "#/$defs/timestamp"
    },
    "session_ref": {
      "$ref": "#/$defs/stable_id"
    },
    "agent": {
      "$ref": "#/$defs/agent"
    },
    "intent": {
      "$ref": "#/$defs/intent"
    },
    "source_snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source_snapshot"
      }
    },
    "signal_refs": {
      "$ref": "#/$defs/id_list"
    },
    "outcome": {
      "$ref": "#/$defs/outcome"
    },
    "explicit_feedback_refs": {
      "$ref": "#/$defs/id_list"
    },
    "privacy": {
      "$ref": "#/$defs/privacy"
    }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "id_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stable_id"
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "version"],
      "properties": {
        "agent_id": {
          "$ref": "#/$defs/stable_id"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "goal_ref", "requested_capabilities"],
      "properties": {
        "category": {
          "type": "string",
          "enum": ["research", "create", "revise", "compare", "plan", "reflect", "continue", "other"]
        },
        "goal_ref": {
          "$ref": "#/$defs/stable_id"
        },
        "requested_capabilities": {
          "$ref": "#/$defs/id_list"
        }
      }
    },
    "source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "artifact_refs", "unresolved_codes"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["completed", "completed-with-gaps", "needs-clarification", "failed", "cancelled"]
        },
        "artifact_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stable_id"
          }
        },
        "unresolved_codes": {
          "$ref": "#/$defs/id_list"
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consent_scope", "retention", "raw_conversation_stored", "direct_identifiers_stored"],
      "properties": {
        "consent_scope": {
          "type": "string",
          "minLength": 1
        },
        "retention": {
          "type": "string",
          "enum": ["reference-only", "external-artifact", "transient"]
        },
        "raw_conversation_stored": {
          "const": false
        },
        "direct_identifiers_stored": {
          "const": false
        }
      }
    }
  }
}
