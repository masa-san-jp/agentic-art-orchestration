{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/masa-san-jp/agentic-art-orchestration/schemas/external-artifact.schema.json",
  "title": "External artifact v1",
  "description": "A create-only reference envelope for immutable user artifacts stored outside Git in Google Drive.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "artifact_id",
    "operation",
    "provider",
    "provider_file_id",
    "mime_type",
    "category",
    "created_at",
    "creator",
    "interaction_id",
    "content_hash",
    "source_snapshots",
    "evidence_refs",
    "access",
    "retention",
    "lineage",
    "feedback_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "external-artifact/v1"
    },
    "artifact_id": {
      "$ref": "#/$defs/stable_id"
    },
    "operation": {
      "const": "CREATE"
    },
    "provider": {
      "const": "google-drive"
    },
    "provider_file_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "mime_type": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9.+-]+/[A-Za-z0-9.+-]+$"
    },
    "category": {
      "type": "string",
      "enum": ["document", "spreadsheet", "presentation", "image", "audio", "video", "archive", "other"]
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "creator": {
      "$ref": "#/$defs/creator"
    },
    "interaction_id": {
      "$ref": "#/$defs/stable_id"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_snapshots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source_snapshot"
      }
    },
    "evidence_refs": {
      "$ref": "#/$defs/id_list"
    },
    "access": {
      "$ref": "#/$defs/access"
    },
    "retention": {
      "$ref": "#/$defs/retention"
    },
    "lineage": {
      "$ref": "#/$defs/lineage"
    },
    "feedback_refs": {
      "$ref": "#/$defs/id_list"
    }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "creator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "version"],
      "properties": {
        "agent_id": {
          "$ref": "#/$defs/stable_id"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "id_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stable_id"
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "consent_scope"],
      "properties": {
        "scope": {
          "type": "string",
          "enum": ["private", "restricted", "shared"]
        },
        "consent_scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "review_at"],
      "properties": {
        "policy": {
          "type": "string",
          "enum": ["keep", "review", "expire"]
        },
        "review_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["derived_from", "supersedes"],
      "properties": {
        "derived_from": {
          "$ref": "#/$defs/id_list"
        },
        "supersedes": {
          "$ref": "#/$defs/id_list"
        }
      }
    }
  }
}
