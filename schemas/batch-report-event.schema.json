{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-art-orchestration/batch-report-event.schema.json",
  "title": "Batch report event",
  "$comment": "1行1事象の追記型。Git 外に置く。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "occurred_at"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "enum": [
        "AGENT_LAUNCHED",
        "TASK_SUCCEEDED",
        "TASK_FAILED",
        "TASK_RETRIED",
        "PROJECT_COMPLETED",
        "PLAN_BUILT"
      ]
    },
    "occurred_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "worker_id": {
      "type": "string",
      "minLength": 1
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "tokens": {
      "type": "integer",
      "minimum": 0,
      "$comment": "エージェントの申告。取得手段がハーネス依存なので自動化しない。欄が無い run は未計測であって 0 ではない。"
    },
    "note": {
      "type": "string",
      "minLength": 1
    }
  }
}
