{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/masa-san-jp/agentic-art-orchestration/schemas/github-issue-delivery.schema.json",
  "title": "Create-only GitHub Issue delivery v1",
  "description": "A privacy-safe plan or live evidence envelope for allowlisted GitHub Issue creation and stable-key reuse.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "delivery_run_id", "mode", "generated_at", "status", "records", "remote_operations"],
  "properties": {
    "contract_version": {"const": "github-issue-delivery/v1"},
    "delivery_run_id": {"$ref": "#/$defs/stable_id"},
    "mode": {"enum": ["PLAN", "LIVE"]},
    "generated_at": {"$ref": "#/$defs/timestamp"},
    "status": {"enum": ["PLANNED", "CREATED", "REUSED", "PARTIAL", "BLOCKED"]},
    "records": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/record"}},
    "remote_operations": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/remote_operation"}}
  },
  "$defs": {
    "stable_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "repository_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "source_kind": {"enum": ["explicit", "inferred", "audit", "repository-update"]},
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_inferred", "hypothesis_status"],
      "properties": {
        "is_inferred": {"type": "boolean"},
        "hypothesis_status": {"enum": ["unconfirmed", "not-applicable"]}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "source_kind", "target_repository", "target_full_name", "deduplication_key", "source_refs", "privacy_safe_summary", "acceptance", "inference", "creation_permitted", "human_gate", "status", "operation", "issue_number", "issue_url", "issue_id_hash"],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/stable_id"},
        "source_kind": {"$ref": "#/$defs/source_kind"},
        "target_repository": {"$ref": "#/$defs/repository_id"},
        "target_full_name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "deduplication_key": {"$ref": "#/$defs/stable_id"},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/stable_id"}},
        "privacy_safe_summary": {"type": "string", "minLength": 1},
        "acceptance": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "inference": {"$ref": "#/$defs/inference"},
        "creation_permitted": {"type": "boolean"},
        "human_gate": {"const": true},
        "status": {"enum": ["PLANNED", "CREATED", "REUSED", "BLOCKED", "DUPLICATE_SUPPRESSED"]},
        "operation": {"enum": ["NONE", "READ", "CREATE", "REUSE"]},
        "issue_number": {"type": ["integer", "null"], "minimum": 1},
        "issue_url": {"type": ["string", "null"], "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/issues/[1-9][0-9]*$"},
        "issue_id_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "remote_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "target_repository", "deduplication_key"],
      "properties": {
        "operation": {"enum": ["READ", "CREATE", "REUSE"]},
        "target_repository": {"$ref": "#/$defs/repository_id"},
        "deduplication_key": {"$ref": "#/$defs/stable_id"},
        "issue_number": {"type": "integer", "minimum": 1}
      }
    }
  }
}
