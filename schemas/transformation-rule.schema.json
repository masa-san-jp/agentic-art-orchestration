{
  "$defs": {
    "attribute_list": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]*$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "rule": {
      "additionalProperties": false,
      "properties": {
        "attribute_bindings": {
          "additionalProperties": false,
          "properties": {
            "art-history": {
              "$ref": "#/$defs/attribute_list"
            },
            "marketing": {
              "$ref": "#/$defs/attribute_list"
            },
            "self": {
              "$ref": "#/$defs/attribute_list"
            }
          },
          "required": [
            "self",
            "art-history",
            "marketing"
          ],
          "type": "object"
        },
        "composition": {
          "additionalProperties": false,
          "properties": {
            "composition_mode": {
              "enum": [
                "intersection"
              ]
            },
            "output_type": {
              "enum": [
                "research_proposition"
              ]
            },
            "slots": {
              "additionalProperties": {
                "$ref": "#/$defs/slot"
              },
              "properties": {
                "contemporary_condition": {
                  "$ref": "#/$defs/slot"
                },
                "historical_operation": {
                  "$ref": "#/$defs/slot"
                },
                "personal_tension": {
                  "$ref": "#/$defs/slot"
                }
              },
              "required": [
                "personal_tension",
                "historical_operation",
                "contemporary_condition"
              ],
              "type": "object"
            },
            "template": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "output_type",
            "slots",
            "template"
          ],
          "type": "object"
        },
        "constraints": {
          "items": {
            "enum": [
              "require_all_inputs",
              "require_source_provenance",
              "no_unproven_concepts"
            ],
            "type": "string"
          },
          "minItems": 3,
          "type": "array",
          "uniqueItems": true
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "rejection_reasons": {
          "items": {
            "enum": [
              "missing-required-signal",
              "unknown-attribute",
              "missing-provenance",
              "constraint-failure"
            ],
            "type": "string"
          },
          "minItems": 4,
          "type": "array",
          "uniqueItems": true
        },
        "required_signal_kinds": {
          "items": {
            "enum": [
              "self",
              "art-history",
              "marketing"
            ],
            "type": "string"
          },
          "minItems": 3,
          "type": "array",
          "uniqueItems": true
        },
        "rule_id": {
          "pattern": "^R[0-9]+$",
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "disabled"
          ],
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "name",
        "status",
        "required_signal_kinds",
        "attribute_bindings",
        "composition",
        "constraints",
        "rejection_reasons"
      ],
      "type": "object"
    },
    "slot": {
      "additionalProperties": false,
      "properties": {
        "attribute": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "signal_kind": {
          "enum": [
            "self",
            "art-history",
            "marketing"
          ],
          "type": "string"
        }
      },
      "required": [
        "signal_kind",
        "attribute"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/masa-san-jp/agentic-art-orchestration/schemas/transformation-rule.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A finite rule that maps declared normalized signal attributes to a structured proposition without free-form ideation.",
  "properties": {
    "contract_version": {
      "const": "transformation-rule/v2"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/rule"
      },
      "minItems": 1,
      "type": "array"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "version",
    "contract_version",
    "rules"
  ],
  "title": "Explicit transformation rule registry v2",
  "type": "object"
}
