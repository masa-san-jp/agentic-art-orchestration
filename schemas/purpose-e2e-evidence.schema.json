{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/masa-san-jp/agentic-art-orchestration/schemas/purpose-e2e-evidence.schema.json",
  "title": "Purpose new-theme E2E evidence",
  "description": "Closed metadata-only evidence for the new-theme purpose E2E.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "attempt_id", "run_id", "project_id", "lane", "generated_at", "terminal_status", "source_observations", "intent", "self_diversity", "pipeline", "research", "production", "viewer", "autonomous", "quality_gates", "human_prompt_count", "forbidden_external_operation_count", "external_operations", "child_mutations", "privacy", "acceptance"],
  "properties": {
    "contract_version": {"const": "purpose-e2e-evidence/v1"},
    "attempt_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,48}$"},
    "run_id": {"type": "string", "pattern": "^PURPOSE-E2E:[A-Za-z0-9][A-Za-z0-9._-]{0,48}$"},
    "project_id": {"type": "string", "pattern": "^project/purpose-e2e-transparent-boundary-[a-z0-9][a-z0-9._-]{0,48}$"},
    "lane": {"enum": ["networkless", "live-private"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "terminal_status": {"enum": ["PLAN_READY", "BLOCKED"]},
    "source_observations": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/source"}},
    "intent": {"type": "object", "additionalProperties": false, "required": ["sha256", "algorithm"], "properties": {"sha256": {"$ref": "#/$defs/hash"}, "algorithm": {"const": "intent-rank/v1"}}},
    "self_diversity": {"type": "object", "additionalProperties": false, "required": ["status", "report_sha256", "eligible_anchor_count", "selected_anchor_count", "fixture_only"], "properties": {"status": {"enum": ["PASS", "PASS_LIMITED_DIVERSITY", "INSUFFICIENT_SELF_DIVERSITY", "REJECT"]}, "report_sha256": {"$ref": "#/$defs/hash"}, "eligible_anchor_count": {"type": "integer", "minimum": 0}, "selected_anchor_count": {"type": "integer", "minimum": 0}, "fixture_only": {"type": "boolean"}}},
    "pipeline": {"type": "object", "additionalProperties": false, "required": ["candidate_space_sha256", "gate_report_sha256", "selection_sha256", "proposition_sha256", "request_sha256", "selected_count", "selected_intent_scores_present"], "properties": {"candidate_space_sha256": {"$ref": "#/$defs/hash"}, "gate_report_sha256": {"$ref": "#/$defs/hash"}, "selection_sha256": {"$ref": "#/$defs/hash"}, "proposition_sha256": {"$ref": "#/$defs/hash"}, "request_sha256": {"$ref": "#/$defs/hash"}, "selected_count": {"const": 1}, "selected_intent_scores_present": {"const": true}}},
    "research": {"type": "object", "additionalProperties": false, "required": ["status", "evidence_claim_decision_handoff_hashes", "source_reference_policy"], "properties": {"status": {"enum": ["COMPLETE", "COMPLETE_WITH_GAPS"]}, "evidence_claim_decision_handoff_hashes": {"type": "object", "additionalProperties": false, "required": ["completion_sha256", "claims_sha256", "decisions_sha256", "handoff_sha256"], "properties": {"completion_sha256": {"$ref": "#/$defs/hash"}, "claims_sha256": {"$ref": "#/$defs/hash"}, "decisions_sha256": {"$ref": "#/$defs/hash"}, "handoff_sha256": {"$ref": "#/$defs/hash"}}}, "source_reference_policy": {"const": "primary-or-explicit-unknown"}}},
    "production": {"type": "object", "additionalProperties": false, "required": ["plan_sha256", "plan_locator", "source_repository", "source_commit", "visual_package", "medium", "materials", "task_count", "executor_capability", "material_status", "rights_status", "safety_status", "human_approval_required", "plan_builder_status"], "properties": {"plan_sha256": {"$ref": "#/$defs/hash"}, "plan_locator": {"$ref": "#/$defs/locator"}, "source_repository": {"const": "agentic-art-production"}, "source_commit": {"$ref": "#/$defs/commit"}, "visual_package": {"$ref": "#/$defs/visualPackage"}, "medium": {"type": "string", "minLength": 1}, "materials": {"type": "array", "items": {"type": "string"}}, "task_count": {"type": "integer", "minimum": 1}, "executor_capability": {"type": "string", "minLength": 1}, "material_status": {"enum": ["UNKNOWN", "PENDING", "CLEAR"]}, "rights_status": {"enum": ["UNKNOWN", "PENDING", "CLEAR"]}, "safety_status": {"enum": ["UNKNOWN", "PENDING", "CLEAR"]}, "human_approval_required": {"const": false}, "plan_builder_status": {"const": "PASSED"}}},
    "viewer": {"type": "object", "additionalProperties": false, "required": ["status", "review_required", "review_kind", "measured_sample_size", "source_record_count", "blind_or_frame_acceptance_test", "source_commits"], "properties": {"status": {"enum": ["UNKNOWN", "SUPPORTED", "CONTRADICTED", "EXTERNALLY_SUPPORTED"]}, "review_required": {"type": "boolean"}, "review_kind": {"enum": ["NONE", "BLIND_OR_FRAME"]}, "measured_sample_size": {"type": "integer", "minimum": 0}, "source_record_count": {"type": "integer", "minimum": 0}, "blind_or_frame_acceptance_test": {"const": true}, "source_commits": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/commit"}}}},
    "autonomous": {"type": "object", "additionalProperties": false, "required": ["run_id", "status", "stage", "transition", "attempts", "retry_count", "human_prompt_count", "worker_invocation_count", "resume_reused", "accepted_result_digest", "privacy"], "properties": {"run_id": {"type": "string", "pattern": "^PURPOSE-E2E:[A-Za-z0-9][A-Za-z0-9._-]{0,48}$"}, "status": {"enum": ["RESEARCH_COMPLETE", "PLAN_READY"]}, "stage": {"enum": ["research", "plan"]}, "transition": {"enum": [["RESEARCH_PENDING", "RESEARCH_WORKER_RUNNING", "RESEARCH_COMPLETE"], ["RESEARCH_PENDING", "RESEARCH_WORKER_RUNNING", "PLAN_READY"]]}, "attempts": {"const": 1}, "retry_count": {"const": 0}, "human_prompt_count": {"const": 0}, "worker_invocation_count": {"const": 1}, "resume_reused": {"const": true}, "accepted_result_digest": {"$ref": "#/$defs/hash"}, "privacy": {"$ref": "#/$defs/runnerPrivacy"}}, "allOf": [{"if": {"properties": {"status": {"const": "RESEARCH_COMPLETE"}}}, "then": {"properties": {"stage": {"const": "research"}, "transition": {"const": ["RESEARCH_PENDING", "RESEARCH_WORKER_RUNNING", "RESEARCH_COMPLETE"]}}}, "else": {"properties": {"stage": {"const": "plan"}, "transition": {"const": ["RESEARCH_PENDING", "RESEARCH_WORKER_RUNNING", "PLAN_READY"]}}}}]},
    "quality_gates": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["repository", "command", "status", "exit_code"], "properties": {"repository": {"type": "string", "minLength": 1}, "command": {"type": "string", "minLength": 1}, "status": {"enum": ["PASSED", "REUSED", "NOT_RUN"]}, "exit_code": {"type": ["integer", "null"]}}}},
    "human_prompt_count": {"const": 0},
    "forbidden_external_operation_count": {"const": 0},
    "external_operations": {"const": []},
    "child_mutations": {"const": []},
    "privacy": {"$ref": "#/$defs/privacy"},
    "acceptance": {"type": "object", "additionalProperties": false, "required": ["networkless_or_private_lane", "plan_ready", "zero_human_prompts_after_input", "intent_reached_selection", "self_diversity_pass", "research_traceable", "production_derived_fields_present", "visual_package_present_and_verified", "viewer_conservative", "resume_idempotent", "child_quality_gates_passed", "zero_forbidden_external_effects", "privacy_boundary_passed"], "properties": {"networkless_or_private_lane": {"const": true}, "plan_ready": {"const": true}, "zero_human_prompts_after_input": {"const": true}, "intent_reached_selection": {"const": true}, "self_diversity_pass": {"const": true}, "research_traceable": {"const": true}, "production_derived_fields_present": {"const": true}, "visual_package_present_and_verified": {"const": true}, "viewer_conservative": {"const": true}, "resume_idempotent": {"const": true}, "child_quality_gates_passed": {"const": true}, "zero_forbidden_external_effects": {"const": true}, "privacy_boundary_passed": {"const": true}}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "locator": {"type": "string", "pattern": "^run://PURPOSE-E2E:[A-Za-z0-9][A-Za-z0-9._:-]*/[A-Za-z0-9._/-]+$"},
    "source": {"type": "object", "additionalProperties": false, "required": ["repository", "source_commit", "branch", "head", "dirty", "pin_status", "workspace_state"], "properties": {"repository": {"type": "string", "enum": ["self-model", "art-history", "marketing-trends", "agentic-art-research", "agentic-art-production", "viewer-response-notes"]}, "source_commit": {"$ref": "#/$defs/commit"}, "branch": {"type": "string", "minLength": 1}, "head": {"oneOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]}, "dirty": {"type": "boolean"}, "pin_status": {"enum": ["MATCHED", "MISMATCH", "DIRTY"]}, "workspace_state": {"enum": ["OFFLINE_FIXTURE", "MATCHED", "STALE", "DIRTY"]}}},
    "visualPackage": {"type": "object", "additionalProperties": false, "required": ["schema_version", "package_id", "revision", "status", "source_repository", "source_commit", "metadata_locator", "package_hash", "fixture_only", "board", "mockup"], "properties": {"schema_version": {"type": "string", "minLength": 1}, "package_id": {"type": "string", "minLength": 1}, "revision": {"type": "integer", "minimum": 1}, "status": {"const": "READY"}, "source_repository": {"const": "agentic-art-production"}, "source_commit": {"$ref": "#/$defs/commit"}, "metadata_locator": {"$ref": "#/$defs/locator"}, "package_hash": {"$ref": "#/$defs/hash"}, "fixture_only": {"type": "boolean"}, "board": {"$ref": "#/$defs/visualAsset"}, "mockup": {"$ref": "#/$defs/visualAsset"}}},
    "visualAsset": {"type": "object", "additionalProperties": false, "required": ["kind", "title", "relative_path", "opaque_reference", "asset_version", "content_hash", "media_type", "rights_status", "safety_status", "external_validation_status", "physical_validation_status", "provenance_source_repository", "provenance_source_commit", "provenance_evidence_locator"], "properties": {"kind": {"enum": ["BOARD", "MOCKUP"]}, "title": {"type": "string", "minLength": 1}, "relative_path": {"type": "string", "pattern": "^03_plan/visual-package/[a-z0-9-]+\\.svg$"}, "opaque_reference": {"$ref": "#/$defs/locator"}, "asset_version": {"type": "string", "minLength": 1}, "content_hash": {"$ref": "#/$defs/hash"}, "media_type": {"const": "image/svg+xml"}, "rights_status": {"const": "PROJECT_INTERNAL"}, "safety_status": {"enum": ["CLEAR", "REVIEW_REQUIRED"]}, "external_validation_status": {"const": "NOT_RUN"}, "physical_validation_status": {"const": "NOT_RUN"}, "provenance_source_repository": {"type": "string", "minLength": 1}, "provenance_source_commit": {"$ref": "#/$defs/commit"}, "provenance_evidence_locator": {"type": "string", "minLength": 1}}},
    "privacy": {"type": "object", "additionalProperties": false, "required": ["theme_stored", "raw_conversation_stored", "credentials_stored", "private_raw_stored", "restricted_stored", "artifact_body_stored"], "properties": {"theme_stored": {"const": false}, "raw_conversation_stored": {"const": false}, "credentials_stored": {"const": false}, "private_raw_stored": {"const": false}, "restricted_stored": {"const": false}, "artifact_body_stored": {"const": false}}},
    "runnerPrivacy": {"type": "object", "additionalProperties": false, "required": ["credentials_stored", "private_raw_stored", "raw_conversation_stored", "restricted_stored"], "properties": {"credentials_stored": {"const": false}, "private_raw_stored": {"const": false}, "raw_conversation_stored": {"const": false}, "restricted_stored": {"const": false}}}
  }
}
