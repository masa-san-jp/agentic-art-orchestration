{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"artifact-record/v1","type":"object","additionalProperties":false,"required":["contract_version","record_id","revision","origin_instance_id","creator_id","owner_repository","collection_id","kind","payload_schema","payload_ref","content_sha256","sources","derived_from","epistemic_status","lifecycle","applicability","rights","access_scope","consent_ref","created_at","reviewed_at","valid_until","producer","supersedes","invalidates"],"properties":{"contract_version":{"const":"artifact-record/v1"},"record_id":{"type":"string","minLength":1},"revision":{"type":"integer","minimum":1},"origin_instance_id":{"type":"string","minLength":1},"creator_id":{"type":"string","minLength":1},"owner_repository":{"type":"string","minLength":1},"collection_id":{"type":"string","minLength":1},"kind":{"type":"string","minLength":1},"payload_schema":{"type":"string","minLength":1},"payload_ref":{"type":"string","pattern":"^[^/].*$"},"content_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"sources":{"type":"array","items":{"type":"object"}},"derived_from":{"type":"array","items":{"type":"object"}},"epistemic_status":{"enum":["observed","externally-supported","inferred","proposed","simulated","unknown"]},"lifecycle":{"enum":["candidate","accepted","rejected","superseded","revoked"]},"applicability":{"type":"object"},"rights":{"type":"object"},"access_scope":{"type":"string","minLength":1},"consent_ref":{"type":["string","null"]},"created_at":{"type":"string","format":"date-time"},"reviewed_at":{"type":["string","null"]},"valid_until":{"type":["string","null"]},"producer":{"type":"object"},"supersedes":{"type":"array","items":{"type":"object"}},"invalidates":{"type":"array","items":{"type":"object"}}}}
