{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/masa-san-jp/agentic-art-orchestration/schemas/project-status.schema.json",
  "title": "Deterministic project status v1",
  "description": "Progress derived only from the orchestration task queue and resumable execution state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "source_hashes",
    "counts",
    "current",
    "ready",
    "blocked",
    "next_task",
    "source_updated_at"
  ],
  "properties": {
    "contract_version": {"const": "project-status/v1"},
    "source_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queue", "state"],
      "properties": {
        "queue": {"$ref": "#/$defs/sha256"},
        "state": {"$ref": "#/$defs/sha256"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["BACKLOG", "READY", "IN_PROGRESS", "BLOCKED", "DONE", "total"],
      "properties": {
        "BACKLOG": {"$ref": "#/$defs/count"},
        "READY": {"$ref": "#/$defs/count"},
        "IN_PROGRESS": {"$ref": "#/$defs/count"},
        "BLOCKED": {"$ref": "#/$defs/count"},
        "DONE": {"$ref": "#/$defs/count"},
        "total": {"$ref": "#/$defs/count"}
      }
    },
    "current": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "repository", "checkpoint", "next_action"],
      "properties": {
        "task_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "repository": {"type": ["string", "null"], "minLength": 1},
        "checkpoint": {"type": ["object", "null"]},
        "next_action": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "ready": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/task_id"}
    },
    "blocked": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "reason"],
        "properties": {
          "task_id": {"$ref": "#/$defs/task_id"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "next_task": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "source_updated_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:[.][0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"}
  }
}
