{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/masa-san-jp/agentic-art-orchestration/schemas/v12-e2e.schema.json",
  "title": "v1.2 research execution E2E v1",
  "description": "A deterministic offline integration proof for the v1.2 research execution pipeline and v1.1 regression boundaries.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "run_id", "network", "pipeline", "child_quality_gates", "v11_regression", "acceptance", "remote_operations"],
  "properties": {
    "contract_version": {"const": "v12-e2e/v1"},
    "run_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "network": {"const": "disabled"},
    "pipeline": {"$ref": "#/$defs/pipeline"},
    "child_quality_gates": {"$ref": "#/$defs/child_quality_gates"},
    "v11_regression": {"$ref": "#/$defs/v11_regression"},
    "acceptance": {"$ref": "#/$defs/acceptance"},
    "remote_operations": {"const": []}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal_count", "rule_set_hash", "snapshot_id", "candidate_count", "gate_report_hash", "selection", "provenance"],
      "properties": {
        "signal_count": {"type": "integer", "minimum": 1},
        "rule_set_hash": {"$ref": "#/$defs/hash"},
        "snapshot_id": {"$ref": "#/$defs/hash"},
        "candidate_count": {"type": "integer", "minimum": 1},
        "gate_report_hash": {"$ref": "#/$defs/hash"},
        "selection": {"$ref": "#/$defs/selection"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "seed_input", "selected_count", "selected_candidate_ids"],
      "properties": {
        "seed": {"$ref": "#/$defs/hash"},
        "seed_input": {"type": "string", "minLength": 1},
        "selected_count": {"type": "integer", "minimum": 1},
        "selected_candidate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^candidate:[0-9a-f]{16}$"}}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "proposition_count", "proposition_ids", "signal_ids", "source_commits", "evidence_locators"],
      "properties": {
        "contract_version": {"const": "research-provenance/v1"},
        "proposition_count": {"type": "integer", "minimum": 1},
        "proposition_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^proposition:[0-9a-f]{16}$"}},
        "signal_ids": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "source_commits": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/commit"}},
        "evidence_locators": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "child_quality_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "repository_count", "statuses", "workspace_states", "execution_modes"],
      "properties": {
        "contract_version": {"const": "child-quality-gates/v1"},
        "repository_count": {"type": "integer", "minimum": 1},
        "statuses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["PASSED", "FAILED", "BLOCKED"]}},
        "workspace_states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["MATCHED", "STALE", "DIRTY", "MISSING", "UNKNOWN"]}},
        "execution_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["immutable-archive", "NOT_RUN"]}}
      }
    },
    "v11_regression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interaction_contract", "artifact_policy", "raw_conversation_stored", "remote_operations", "acceptance"],
      "properties": {
        "interaction_contract": {"const": "interaction-e2e/v1"},
        "artifact_policy": {"const": "CREATE_ONLY"},
        "raw_conversation_stored": {"const": false},
        "remote_operations": {"const": []},
        "acceptance": {"type": "object", "additionalProperties": false, "required": ["retrieval_versioned", "artifact_immutable", "feedback_captured", "issue_routed", "improvement_checkpointed", "audit_independent", "no_remote_mutation"], "properties": {"retrieval_versioned": {"const": true}, "artifact_immutable": {"const": true}, "feedback_captured": {"const": true}, "issue_routed": {"const": true}, "improvement_checkpointed": {"const": true}, "audit_independent": {"const": true}, "no_remote_mutation": {"const": true}}}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signals_to_provenance", "selection_deterministic", "child_gates_observed", "v11_unchanged", "no_child_mutation", "no_remote_mutation"],
      "properties": {
        "signals_to_provenance": {"const": true},
        "selection_deterministic": {"const": true},
        "child_gates_observed": {"const": true},
        "v11_unchanged": {"const": true},
        "no_child_mutation": {"const": true},
        "no_remote_mutation": {"const": true}
      }
    }
  }
}
