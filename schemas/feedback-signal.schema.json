{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/masa-san-jp/agentic-art-orchestration/schemas/feedback-signal.schema.json",
  "title": "Feedback signal v1",
  "description": "A privacy-minimal feedback envelope that keeps inferred needs as hypotheses rather than user facts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "feedback_id", "kind", "observed_at", "source", "summary_code", "evidence_refs", "confidence", "hypothesis", "target", "consent", "promoted_to_user_fact"],
  "properties": {
    "contract_version": {"const": "feedback-signal/v1"},
    "feedback_id": {"$ref": "#/$defs/stable_id"},
    "kind": {
      "type": "string",
      "enum": ["explicit_request", "explicit_dissatisfaction", "output_correction", "knowledge_gap", "inferred_friction", "inferred_need"]
    },
    "observed_at": {"$ref": "#/$defs/timestamp"},
    "source": {"$ref": "#/$defs/source"},
    "summary_code": {"$ref": "#/$defs/stable_id"},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/stable_id"}},
    "confidence": {"$ref": "#/$defs/confidence"},
    "hypothesis": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/hypothesis"}
      ]
    },
    "target": {"$ref": "#/$defs/target"},
    "consent": {"$ref": "#/$defs/consent"},
    "promoted_to_user_fact": {"const": false}
  },
  "$defs": {
    "stable_id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "id_list": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/stable_id"}},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interaction_id", "event_id", "artifact_refs"],
      "properties": {
        "interaction_id": {"$ref": "#/$defs/stable_id"},
        "event_id": {"$ref": "#/$defs/stable_id"},
        "artifact_refs": {"$ref": "#/$defs/id_list"}
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "score"],
      "properties": {
        "level": {"type": "string", "enum": ["explicit", "high", "medium", "low"]},
        "score": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_code", "confirmation_status", "counterevidence_refs"],
      "properties": {
        "claim_code": {"$ref": "#/$defs/stable_id"},
        "confirmation_status": {"type": "string", "enum": ["unconfirmed", "confirmed", "rejected"]},
        "counterevidence_refs": {"$ref": "#/$defs/id_list"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_repository", "routing_status"],
      "properties": {
        "owner_repository": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "routing_status": {"type": "string", "enum": ["candidate", "confirmed", "triage"]}
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "issue_creation_permitted", "profile_update_permitted"],
      "properties": {
        "scope": {"type": "string", "minLength": 1},
        "issue_creation_permitted": {"type": "boolean"},
        "profile_update_permitted": {"const": false}
      }
    }
  }
}
