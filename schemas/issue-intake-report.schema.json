{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/masa-san-jp/agentic-art-orchestration/schemas/issue-intake-report.schema.json",
  "title": "Open Issue intake report v1",
  "description": "A deterministic, metadata-only observation of open Issues that are or are not registered in the execution queue.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "source", "queue", "issues", "summary"],
  "properties": {
    "contract_version": {"const": "issue-intake-report/v1"},
    "source": {"$ref": "#/$defs/source"},
    "queue": {"$ref": "#/$defs/queue"},
    "issues": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/issue"}
    },
    "summary": {"$ref": "#/$defs/summary"}
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "full_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator", "observed_at"],
      "properties": {
        "kind": {"enum": ["fixture", "json", "live"]},
        "locator": {"type": "string", "minLength": 1},
        "observed_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "queued_issue_urls"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "queued_issue_urls": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/issues/[1-9][0-9]*$"}
        }
      }
    },
    "ssot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observable_acceptance", "target_repository", "verification_commands", "human_gate", "qualified", "missing"],
      "properties": {
        "observable_acceptance": {"type": "boolean"},
        "target_repository": {"type": "boolean"},
        "verification_commands": {"type": "boolean"},
        "human_gate": {"type": "boolean"},
        "qualified": {"type": "boolean"},
        "missing": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["observable_acceptance", "target_repository", "verification_commands", "human_gate"]}
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "number", "title", "url", "queued", "ssot", "recommendation"],
      "properties": {
        "repository": {"$ref": "#/$defs/full_name"},
        "number": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/issues/[1-9][0-9]*$"},
        "queued": {"type": "boolean"},
        "ssot": {"$ref": "#/$defs/ssot"},
        "recommendation": {"enum": ["ALREADY_QUEUED", "REGISTER_BACKLOG", "UNQUEUED_NEEDS_SSOT"]}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "queued", "qualified_unqueued", "unqueued_needs_ssot"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "queued": {"type": "integer", "minimum": 0},
        "qualified_unqueued": {"type": "integer", "minimum": 0},
        "unqueued_needs_ssot": {"type": "integer", "minimum": 0}
      }
    }
  }
}
