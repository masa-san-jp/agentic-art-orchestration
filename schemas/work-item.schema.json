{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/masa-san-jp/agentic-art-orchestration/schemas/work-item.schema.json",
  "title": "Cross-repository work item v1",
  "description": "A resumable work unit with explicit ownership, scope, risk, checks, and terminal evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "title",
    "owner_repository",
    "target_repositories",
    "allowed_paths",
    "depends_on",
    "context",
    "acceptance",
    "checks",
    "risk",
    "attempts",
    "lease",
    "checkpoint",
    "terminal_criteria",
    "terminal_state",
    "evidence"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]+-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "owner_repository": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "target_repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9-]+-[0-9]{3}$"
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_files", "contracts", "source_commits"],
      "properties": {
        "required_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^normalized-research-signal/v[1-9][0-9]*$"
          }
        },
        "source_commits": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/acceptance"
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "risk": {
      "$ref": "#/$defs/risk"
    },
    "attempts": {
      "$ref": "#/$defs/attempts"
    },
    "lease": {
      "$ref": "#/$defs/lease"
    },
    "checkpoint": {
      "$ref": "#/$defs/checkpoint"
    },
    "terminal_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "terminal_state": {
      "type": "string",
      "enum": ["BACKLOG", "READY", "IN_PROGRESS", "DONE", "BLOCKED"]
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    }
  },
  "$defs": {
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "observable"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "observable": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "command", "required"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "data_boundary", "mitigations"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "data_boundary": {
          "type": "string",
          "enum": ["no-sensitive", "derived-only", "restricted-review"]
        },
        "mitigations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "attempts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["used", "max"],
      "properties": {
        "used": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "owner", "expires_at"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["available", "held"]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "execution_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_point", "next_action", "last_result"],
      "properties": {
        "start_point": {
          "type": "string",
          "minLength": 1
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        },
        "last_result": {
          "type": "string",
          "enum": ["not_started", "running", "checkpointed", "interrupted", "passed", "failed", "blocked"]
        },
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "execution_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commits", "pull_requests", "tests", "changed_paths"],
      "properties": {
        "commits": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "pull_requests": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/pull/[1-9][0-9]*$"
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "changed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
